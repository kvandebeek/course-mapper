{
  "name": "udemy-business-course-scraper",
  "version": "1.0.0",
  "description": "Production-ready CLI to scrape Udemy Business catalog results for keywords and export top courses CSV.",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scrape": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx src/smoke.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "playwright": "^1.53.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
